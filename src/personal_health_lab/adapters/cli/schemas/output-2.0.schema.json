{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-health-lab:cli-output:2.0",
  "title": "HealthLab production CLI write output 2.0",
  "oneOf": [
    {
      "$ref": "#/$defs/writePlanOutput"
    },
    {
      "$ref": "#/$defs/writeReceiptOutput"
    },
    {
      "$ref": "#/$defs/dataReviewOutput"
    },
    {
      "$ref": "#/$defs/plausibilityRulesOutput"
    }
  ],
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "plausibilityRulesOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "runtime_config", "schema_version"],
      "properties": {
        "rules": {"type": "array", "items": {"type": "object"}},
        "runtime_config": {"$ref": "#/$defs/runtimeConfig"},
        "schema_version": {"const": "2.0"}
      }
    },
    "runtimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_import_compression_ratio",
        "max_import_entries",
        "max_import_entry_bytes",
        "max_import_package_bytes",
        "max_import_uncompressed_bytes",
        "mode",
        "real_store",
        "schema_version",
        "synthetic_store"
      ],
      "properties": {
        "max_import_compression_ratio": {
          "type": "number",
          "minimum": 1
        },
        "max_import_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_import_entry_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_import_package_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_import_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "synthetic",
            "real"
          ]
        },
        "real_store": {
          "const": "<redacted>"
        },
        "schema_version": {
          "const": "1.0"
        },
        "synthetic_store": {
          "const": "<redacted>"
        }
      }
    },
    "dataReviewOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "cycles", "runtime_config", "schema_version", "selection", "snapshot_ref", "status"],
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed_actions", "candidate_version_ids", "case_id", "detail", "evidence_fingerprint", "kind", "logical_measurement_id", "measurement_version_id", "rule_version_id"],
            "properties": {
              "allowed_actions": {
                "type": "array",
                "items": {"enum": ["confirm", "reject", "prefer", "split"]}
              },
              "candidate_version_ids": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "case_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": ["effective_value", "effective_value_source", "measured_at", "reasons", "source_type"],
                "properties": {
                  "effective_value": {"type": ["number", "null"]},
                  "effective_value_source": {"enum": ["source", "correction", "none", null]},
                  "measured_at": {"$ref": "#/$defs/nullableString"},
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["code", "lower_bound", "upper_bound", "unit"],
                      "properties": {
                        "code": {"enum": ["below_fixed_lower_bound", "above_fixed_upper_bound", "below_personal_lower_bound", "above_personal_upper_bound"]},
                        "lower_bound": {"type": "number"},
                        "upper_bound": {"type": ["number", "null"]},
                        "unit": {"type": "string"}
                      }
                    }
                  },
                  "source_type": {"$ref": "#/$defs/nullableString"}
                }
              },
              "evidence_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "kind": {"enum": ["plausibility", "rule_definition", "suspected_source_deletion", "source_conflict"]},
              "logical_measurement_id": {"$ref": "#/$defs/nullableString"},
              "measurement_version_id": {"$ref": "#/$defs/nullableString"},
              "rule_version_id": {"$ref": "#/$defs/nullableString"}
            }
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cycle_id", "open_case_count", "snapshot_ref", "status"],
            "properties": {
              "cycle_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "open_case_count": {"type": "integer", "minimum": 0},
              "snapshot_ref": {"type": "string"},
              "status": {"enum": ["open", "closed"]}
            }
          }
        },
        "runtime_config": {"$ref": "#/$defs/runtimeConfig"},
        "schema_version": {"const": "2.0"},
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"type": ["string", "null"]}}
        },
        "snapshot_ref": {"$ref": "#/$defs/nullableString"},
        "status": {"enum": ["reviewed", "provisional"]}
      }
    },
    "writeApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "confirmation_required",
            "blocked"
          ]
        }
      }
    },
    "fileVaultCheck": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "status",
            "target_volume"
          ],
          "properties": {
            "reason": {
              "enum": [
                null,
                "unsupported_platform",
                "mount_unresolved",
                "disk_info_unavailable",
                "volume_identity_missing",
                "volume_locked",
                "apfs_state_unavailable",
                "filevault_state_unavailable",
                "filevault_state_unreported",
                "encryption_state_unconfirmed",
                "probe_failed"
              ]
            },
            "status": {
              "enum": [
                "protected",
                "unprotected",
                "transitioning",
                "unknown"
              ]
            },
            "target_volume": {
              "type": "string"
            }
          }
        }
      ]
    },
    "capacityCheck": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available_bytes",
            "estimate_bytes",
            "fragment_size",
            "method_id",
            "minimum_remaining_bytes",
            "reason",
            "required_bytes",
            "safety_margin_bytes",
            "status",
            "target_volume"
          ],
          "properties": {
            "available_bytes": {"type": ["integer", "null"], "minimum": 0},
            "estimate_bytes": {"type": ["integer", "null"], "minimum": 0},
            "fragment_size": {"type": ["integer", "null"], "minimum": 1},
            "method_id": {"const": "full-snapshot-import/v1"},
            "minimum_remaining_bytes": {"type": "integer", "minimum": 0},
            "reason": {
              "enum": [
                null,
                "estimate_unknown",
                "space_unknown",
                "target_read_only",
                "target_unwritable"
              ]
            },
            "required_bytes": {"type": ["integer", "null"], "minimum": 0},
            "safety_margin_bytes": {"type": ["integer", "null"], "minimum": 0},
            "status": {"enum": ["ready", "insufficient", "unknown", "unwritable"]},
            "target_volume": {"type": "string", "pattern": "^(volume-[0-9a-f]{12}|unresolved)$"}
          }
        }
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_reads",
        "allowed_writes",
        "mode",
        "person_binding",
        "state",
        "store_id"
      ],
      "properties": {
        "allowed_reads": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_writes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mode": {
          "enum": ["synthetic", "real"]
        },
        "person_binding": {
          "enum": ["unbound", "bound", "pending"]
        },
        "state": {
          "enum": ["ready", "migration_required"]
        },
        "store_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "importResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anomaly_count",
        "diagnostics",
        "import_id",
        "logical_measurement_count",
        "measurement_version_count",
        "source_occurrence_count",
        "package_hash",
        "package_record_count",
        "record_count",
        "snapshot_ref",
        "status",
        "type"
      ],
      "properties": {
        "anomaly_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import_id": {
          "type": "string"
        },
        "logical_measurement_count": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_version_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_occurrence_count": {
          "type": "integer",
          "minimum": 0
        },
        "package_hash": {
          "type": "string"
        },
        "package_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "status": {
          "enum": [
            "committed",
            "duplicate",
            "rejected",
            "quarantined"
          ]
        },
        "type": {
          "const": "import_health_export"
        }
      }
    },
    "writeNotStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostics",
        "status",
        "type"
      ],
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "plan_changed",
            "blocked",
            "store_busy"
          ]
        },
        "type": {
          "const": "write_not_started"
        }
      }
    },
    "plausibilityRuleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostics", "rule_version_id", "snapshot_ref", "status", "type"],
      "properties": {
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "rule_version_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_ref": {"$ref": "#/$defs/nullableString"},
        "status": {"const": "committed"},
        "type": {"const": "create_plausibility_rule_version"}
      }
    },
    "dataReviewDecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "diagnostics", "snapshot_ref", "status", "type"],
      "properties": {
        "decision_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "snapshot_ref": {"type": "string"},
        "status": {"const": "committed"},
        "type": {"const": "data_review_decision"}
      }
    },
    "writePlanOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval",
        "confirmations",
        "details",
        "diagnostics",
        "fingerprint",
        "kind",
        "preflight",
        "request",
        "runtime_config",
        "schema_version",
        "workspace"
      ],
      "properties": {
        "approval": {
          "$ref": "#/$defs/writeApproval"
        },
        "confirmations": {
          "type": "array",
          "items": {
            "enum": [
              "real_import_same_person",
              "filevault_unprotected",
              "filevault_transitioning",
              "filevault_unknown",
              "legacy_store_migration"
            ]
          }
        },
        "details": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["package_hash", "package_size", "type"],
              "properties": {
                "package_hash": {"type": "string"},
                "package_size": {"type": "integer", "minimum": 0},
                "type": {"const": "import_health_export"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["active_snapshot_ref", "previous_version_id", "proposed_version_id", "type"],
              "properties": {
                "active_snapshot_ref": {"$ref": "#/$defs/nullableString"},
                "previous_version_id": {"$ref": "#/$defs/nullableString"},
                "proposed_version_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "type": {"const": "create_plausibility_rule_version"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["active_snapshot_ref", "case_id", "type"],
              "properties": {
                "active_snapshot_ref": {"$ref": "#/$defs/nullableString"},
                "case_id": {"$ref": "#/$defs/nullableString"},
                "type": {"const": "data_review_decision"}
              }
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "const": "write_plan"
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capacity", "filevault"],
          "properties": {
            "capacity": {"$ref": "#/$defs/capacityCheck"},
            "filevault": {"$ref": "#/$defs/fileVaultCheck"}
          }
        },
        "request": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["package", "type"],
              "properties": {
                "package": {"const": "<redacted>"},
                "type": {"const": "import_health_export"}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {"enum": ["create_plausibility_rule_version", "data_review_decision"]}
              }
            }
          ]
        },
        "runtime_config": {
          "$ref": "#/$defs/runtimeConfig"
        },
        "schema_version": {
          "const": "2.0"
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        }
      }
    },
    "writeReceiptOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostics",
        "final_preflight",
        "kind",
        "operation_id",
        "plan_fingerprint",
        "result",
        "runtime_config",
        "schema_version"
      ],
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval",
            "confirmations",
            "capacity",
            "diagnostics",
            "filevault"
          ],
          "properties": {
            "approval": {
              "$ref": "#/$defs/writeApproval"
            },
            "confirmations": {
              "type": "array",
              "items": {
                "enum": [
                  "real_import_same_person",
                  "filevault_unprotected",
                  "filevault_transitioning",
                  "filevault_unknown",
                  "legacy_store_migration"
                ]
              }
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "capacity": {
              "$ref": "#/$defs/capacityCheck"
            },
            "filevault": {
              "$ref": "#/$defs/fileVaultCheck"
            }
          }
        },
        "kind": {
          "const": "write_receipt"
        },
        "operation_id": {
          "type": "string"
        },
        "plan_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/importResult"
            },
            {
              "$ref": "#/$defs/writeNotStarted"
            },
            {
              "$ref": "#/$defs/plausibilityRuleResult"
            },
            {
              "$ref": "#/$defs/dataReviewDecisionResult"
            }
          ]
        },
        "runtime_config": {
          "$ref": "#/$defs/runtimeConfig"
        },
        "schema_version": {
          "const": "2.0"
        }
      }
    }
  }
}
